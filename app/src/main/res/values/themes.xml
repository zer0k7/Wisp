<resources>
    <style name="Theme.Wisp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0A10</item>
        <item name="android:navigationBarColor">#0A0A10</item>
    </style>

    <style name="Theme.Wisp.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
